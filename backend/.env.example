# Get a FREE key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=paste_your_key_here

# Free-tier models (Oct 2026). Flash-Lite has the most generous daily quota.
#   gemini-3.5-flash-lite  <- default, best free quota
#   gemini-3.1-flash-lite
#   gemini-3.6-flash       <- better taste, much smaller daily quota
#   gemini-3.8-flash
# Check YOUR project's actual limits at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of sites allowed to call this API.
# Leave empty while developing locally; set it to your live frontend URL once deployed.
ALLOWED_ORIGINS=
